### [SOAP] Save New Maintenance Log
### NOTE: equipmentId and technicianId must match real records
POST http://localhost:8080/VitalTrack/MaintenanceLogSoapService/MaintenanceLogSoapApi
Content-Type: text/xml
Accept: text/xml
Authorization: Bearer <paste-your-token-here>

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:soap="http://soap.app/">
   <soapenv:Header/>
   <soapenv:Body>
      <soap:save>
         <log>
            <equipmentId>1</equipmentId>
            <technicianId>1</technicianId>
            <serviceDate>2026-05-28</serviceDate>
            <actionTaken>Preventive maintenance and full calibration of patient monitor</actionTaken>
            <notes>Replaced display backlight unit. Recalibrated SpO2 and NIBP sensors. All readings within acceptable tolerance. Equipment cleared for use in ICU Ward 3.</notes>
         </log>
      </soap:save>
   </soapenv:Body>
</soapenv:Envelope>

###

