### ================================================================
###  MAINTENANCE LOG SOAP ENDPOINTS
### ================================================================

###

### [SOAP] List All Maintenance Logs
POST http://localhost:8080/VitalTrack/MaintenanceLogSoapService/MaintenanceLogSoapApi
Content-Type: text/xml
Accept: text/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:soap="http://soap.app/">
   <soapenv:Header/>
   <soapenv:Body>
      <soap:list/>
   </soapenv:Body>
</soapenv:Envelope>

###

### [SOAP] Find Maintenance Log by ID
POST http://localhost:8080/VitalTrack/MaintenanceLogSoapService/MaintenanceLogSoapApi
Content-Type: text/xml
Accept: text/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:soap="http://soap.app/">
   <soapenv:Header/>
   <soapenv:Body>
      <soap:find>
         <id>1</id>
      </soap:find>
   </soapenv:Body>
</soapenv:Envelope>

###

### [SOAP] Save New Maintenance Log
### NOTE: equipmentId and technicianId must match real records
POST http://localhost:8080/VitalTrack/MaintenanceLogSoapService/MaintenanceLogSoapApi
Content-Type: text/xml
Accept: text/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:soap="http://soap.app/">
   <soapenv:Header/>
   <soapenv:Body>
      <soap:save>
         <log>
            <equipmentId>1</equipmentId>
            <technicianId>1</technicianId>
            <actionTaken>SOAP-based full system diagnostic</actionTaken>
            <notes>Ran full diagnostic via SOAP service. All sensors within normal range.</notes>
         </log>
      </soap:save>
   </soapenv:Body>
</soapenv:Envelope>

###

### [SOAP] Delete Maintenance Log by ID (change id as needed)
POST http://localhost:8080/VitalTrack/MaintenanceLogSoapService/MaintenanceLogSoapApi
Content-Type: text/xml
Accept: text/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:soap="http://soap.app/">
   <soapenv:Header/>
   <soapenv:Body>
      <soap:delete>
         <id>5</id>
      </soap:delete>
   </soapenv:Body>
</soapenv:Envelope>


